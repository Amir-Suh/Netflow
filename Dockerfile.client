# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS build
WORKDIR /src

COPY go.mod ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/netflow-client ./cmd/client

FROM alpine:3.21
RUN adduser -D -H -u 10002 netflow
USER netflow
WORKDIR /app
COPY --from=build /out/netflow-client /app/netflow-client
EXPOSE 8081
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD wget -qO- http://localhost:8081/healthz >/dev/null || exit 1
ENTRYPOINT ["/app/netflow-client"]
