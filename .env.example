# Local API
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# Dockerized Go client interface
CLIENT_HTTP_ADDR=:8081
NETFLOW_API_BASE_URL=http://api:8080

# PostgreSQL
DATABASE_URL=postgres://netflow:netflow@postgres-primary:5432/netflow?sslmode=disable
DATABASE_REPLICA_URL=postgres://netflow:netflow@postgres-replica:5432/netflow?sslmode=disable

# RabbitMQ
RABBITMQ_URL=amqp://netflow:netflow@rabbitmq:5672/
RABBITMQ_EXCHANGE=netflow.events
RABBITMQ_QUEUE=transactions.ingested
# Cycle 2: routing key the arbitrage worker listens on; consumed by workers/arbitrage.
ARBITRAGE_QUEUE=transactions.arbitrage

# Auth
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-bytes
JWT_TTL=24h

# AES-256-GCM. This sample is exactly 32 bytes after base64 decode.
# Replace for local development; never reuse this value outside local sandbox testing.
AES_256_GCM_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AES_KEY_ID=local-sandbox-v1

# Plaid Sandbox only. Do not set development or production here.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace-with-plaid-sandbox-client-id
PLAID_SECRET=replace-with-plaid-sandbox-secret
PLAID_WEBHOOK_URL=http://localhost:8080/plaid/webhook

# Plaid Sandbox Link test user credentials for the frontend/manual flow:
# username: user_good
# password: pass_good
# For dynamic transaction and webhook testing, use user_transactions_dynamic
# with any non-blank password and a non-OAuth institution such as ins_109508.
